{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "helm-ls": {
      "command": [
        "helm_ls",
        "serve"
      ],
      "extensions": [
        ".yaml",
        ".yml",
        ".tpl"
      ],
      "initialization": {
        "helm-ls": {
          "logLevel": "info",
          "helmLint": {
            "enabled": true
          },
          "yamlls": {
            "enabled": true,
            "path": "yaml-language-server",
            "config": {
              "schemas": {
                "kubernetes": "templates/**"
              },
              "completion": true,
              "hover": true
            }
          }
        }
      }
    }
  },
  "server": {
    "port": 4096
  },
  "model": "anthropic/claude-opus-5",
  "agent": {
    "build": {
      "model": "anthropic/claude-opus-5"
    }
  },
  "provider": {
    "anthropic": {
      "models": {
        "claude-opus-5": {
          "reasoning": false
        },
        "claude-sonnet-5": {
          "reasoning": false
        }
      }
    }
  },
  "mcp": {
    "hexdocs-mcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "hexdocs-mcp@0.5.0"
      ],
      "enabled": true
    },
    "linear": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "https://mcp.linear.app/mcp"
      ],
      "enabled": true
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "oauth": {}
    },
    "datadog": {
      "type": "remote",
      "url": "https://mcp.datadoghq.com/api/unstable/mcp-server/mcp"
    },
    "slack": {
      "type": "remote",
      "url": "https://mcp.slack.com/mcp",
      "enabled": true,
      "oauth": {
        "clientId": "1601185624273.8899143856786",
        "redirectUri": "http://localhost:3118/callback"
      }
    }
  }
}
